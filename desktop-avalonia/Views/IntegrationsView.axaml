<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Synapse.Desktop.ViewModels"
             xmlns:m="clr-namespace:Synapse.Desktop.Models"
             x:Class="Synapse.Desktop.Views.IntegrationsView"
             x:DataType="vm:IntegrationsViewModel">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="30,8,30,28" MaxWidth="1120" Spacing="20">

      <!-- ============================================================
           Header
           ============================================================ -->
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="5">
          <TextBlock Classes="h1" Text="Connected apps" />
          <TextBlock Classes="sub"
                     Text="Connect your own tools with client IDs, bot tokens or webhooks. Results are dispatched to the apps you select." />
        </StackPanel>

        <TextBox Grid.Column="1"
                 Text="{Binding SearchQuery}"
                 Width="240"
                 Watermark="Search apps..."
                 VerticalAlignment="Center" />
      </Grid>

      <!-- ============================================================
           App grid
           ============================================================ -->
      <ItemsControl ItemsSource="{Binding FilteredIntegrations}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="m:IntegrationItem">
            <Border Classes="card"
                    Width="320"
                    Margin="0,0,16,16"
                    Padding="18"
                    BoxShadow="0 1 2 0 #0D2B2013">
              <StackPanel Spacing="12">

                <!-- Title row -->
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Name}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="{Binding Category}"
                               FontSize="11"
                               Foreground="{DynamicResource TextTertiary}" />
                  </StackPanel>

                  <Border Grid.Column="1"
                          Classes="badge ok"
                          IsVisible="{Binding IsConnected}"
                          VerticalAlignment="Top">
                    <TextBlock Text="Connected"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Success}" />
                  </Border>

                  <Border Grid.Column="1"
                          Classes="badge"
                          IsVisible="{Binding !IsConnected}"
                          VerticalAlignment="Top">
                    <TextBlock Text="Not connected"
                               FontSize="10.5"
                               Foreground="{DynamicResource TextTertiary}" />
                  </Border>
                </Grid>

                <TextBlock Text="{Binding Description}"
                           Classes="sub"
                           TextWrapping="Wrap"
                           MinHeight="36" />

                <Border Classes="hairline" />

                <!-- Actions -->
                <Grid ColumnDefinitions="*,Auto">
                  <CheckBox Grid.Column="0"
                            Content="Include in dispatch"
                            IsChecked="{Binding IsSelected}"
                            Command="{Binding $parent[UserControl].((vm:IntegrationsViewModel)DataContext).ToggleDispatchCommand}"
                            CommandParameter="{Binding}"
                            VerticalAlignment="Center" />

                  <Button Grid.Column="1"
                          Classes="ghost"
                          Content="Configure"
                          Command="{Binding $parent[UserControl].((vm:IntegrationsViewModel)DataContext).ToggleConfigureCommand}"
                          CommandParameter="{Binding}" />
                </Grid>

                <!-- Configuration drawer -->
                <Border Classes="inset"
                        Padding="14"
                        IsVisible="{Binding IsConfiguring}">
                  <StackPanel Spacing="10">

                    <!-- Guided 2-Step Action Buttons -->
                    <Grid ColumnDefinitions="*,*">
                      <Button Grid.Column="0"
                              Classes="primary"
                              Margin="0,0,4,0"
                              HorizontalAlignment="Stretch"
                              Command="{Binding $parent[UserControl].((vm:IntegrationsViewModel)DataContext).ConnectBrowserAuthCommand}"
                              CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5">
                          <TextBlock Text="1. Open in Browser" FontSize="11.5" FontWeight="SemiBold" />
                          <Path Classes="icon" Data="{StaticResource IconExternalLink}" Width="10" Height="10" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>

                      <Button Grid.Column="1"
                              Classes="secondary"
                              Margin="4,0,0,0"
                              HorizontalAlignment="Stretch"
                              Command="{Binding $parent[UserControl].((vm:IntegrationsViewModel)DataContext).PasteAndConnectCommand}"
                              CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5">
                          <TextBlock Text="2. Paste and Connect" FontSize="11.5" FontWeight="SemiBold" />
                        </StackPanel>
                      </Button>
                    </Grid>

                    <!-- Helpful Guidance Description -->
                    <TextBlock Text="{Binding HelpText}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap" />

                    <!-- Status Text Indicator -->
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="11"
                               Foreground="{DynamicResource TextTertiary}"
                               TextWrapping="Wrap" />

                    <Border Classes="hairline" Margin="0,2" />

                    <!-- Manual input fields -->
                    <StackPanel Spacing="4">
                      <TextBlock Classes="caption" Text="TOKEN / WEBHOOK" />
                      <TextBox Text="{Binding ApiKeyOrToken}"
                               Watermark="{Binding CredentialPlaceholder}"
                               PasswordChar="*" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                      <TextBlock Classes="caption" Text="TARGET / CHANNEL / REPO" />
                      <TextBox Text="{Binding TargetDestination}"
                               Watermark="{Binding TargetPlaceholder}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                      <Button Classes="secondary"
                              Content="Save changes"
                              Command="{Binding $parent[UserControl].((vm:IntegrationsViewModel)DataContext).SaveIntegrationCredentialsCommand}"
                              CommandParameter="{Binding}" />
                    </StackPanel>

                  </StackPanel>
                </Border>

              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>
  </ScrollViewer>

</UserControl>
