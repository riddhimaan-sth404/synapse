<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 16x16 thin-stroke icon set, drawn to match Antigravity's outline style.
       Use with: <Path Classes="icon" Data="{StaticResource IconX}" /> -->

