  <StreamGeometry x:Key="IconMaximize">M3.8 3.8 H12.2 V12.2 H3.8 Z</StreamGeometry>

  <StreamGeometry x:Key="IconRestore">M5 5.4 H12.2 V12.6 H5 Z M3.4 10.4 V3.2 H10.6</StreamGeometry>

