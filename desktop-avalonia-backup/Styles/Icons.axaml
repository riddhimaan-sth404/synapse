  <StreamGeometry x:Key="IconArrowUp">M8 13 V3.2 M4 7.2 L8 3.2 L12 7.2</StreamGeometry>

  <StreamGeometry x:Key="IconClose">M4.2 4.2 L11.8 11.8 M11.8 4.2 L4.2 11.8</StreamGeometry>

